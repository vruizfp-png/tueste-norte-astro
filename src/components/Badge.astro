---
interface Props {
  texto: string;
  tono: 'tueste' | 'origen' | 'nuevo';
}

const { texto, tono } = Astro.props;

// Mapeo de tonos → clases de Tailwind
const clasesPorTono: Record<string, string> = {
  tueste: 'bg-amber-600 text-white',
  origen: 'bg-stone-700 text-white',
  nuevo: 'bg-green-600 text-white',
};

const clasesBase = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium';
const clasesTono = clasesPorTono[tono] ?? clasesPorTono.tueste;
---

<span class={`${clasesBase} ${clasesTono}`}>
  {texto}
</span>
