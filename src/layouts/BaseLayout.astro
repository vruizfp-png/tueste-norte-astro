---
const { titulo } = Astro.props;
// Esto elimina cualquier barra final duplicada y deja la ruta limpia: "/tueste-norte-astro"
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} - Tueste Norte</title>
    <link rel="stylesheet" href={`${base}/styles.css`} />
  </head>

  <body class="bg-stone-100 text-stone-800 max-w-3xl mx-auto py-10 px-4">
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-4 text-center">Tueste Norte</h1>

      <nav class="flex justify-center space-x-6 text-lg">
        <a href={`${base}/`} class="text-amber-700 hover:underline">Inicio</a>
        <a href={`${base}/productos`} class="text-amber-700 hover:underline">Productos</a>
        <a href={`${base}/quienes-somos`} class="text-amber-700 hover:underline">Quiénes somos</a>
        <a href={`${base}/avisos`} class="text-amber-700 hover:underline">Avisos</a>
        <a href={`${base}/contacto`} class="text-amber-700 hover:underline">Contacto</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-10 text-center text-sm text-stone-500 border-t pt-6">
      © 2026 Tueste Norte
    </footer>
  </body>
</html>