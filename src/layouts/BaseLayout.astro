---
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{titulo} - Tueste Norte</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="bg-stone-100 text-stone-800 max-w-3xl mx-auto py-10">
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-4">Tueste Norte</h1>

      <nav class="space-x-4 text-lg">
        <a href="/" class="text-amber-700 hover:underline">Inicio</a>
        <a href="/quienes-somos" class="text-amber-700 hover:underline">Quiénes somos</a>
        <a href="/avisos" class="text-amber-700 hover:underline">Avisos</a>
        <a href="/contacto" class="text-amber-700 hover:underline">Contacto</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-10 text-center text-sm text-stone-500">
      © 2026 Tueste Norte
    </footer>
  </body>
</html>